<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Font Families (Clean Grotesque: Inter -> Segoe UI Variable -> system fallback) -->
    <FontFamily x:Key="FontFamilyDefault">avares://Avalonia.Fonts.Inter/Assets#Inter, Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, Helvetica, Arial, sans-serif</FontFamily>
    <FontFamily x:Key="FontFamilyMonospace">Consolas, Cascadia Code, SF Mono, Menlo, Courier New, monospace</FontFamily>

    <!-- Font Sizes -->
    <x:Double x:Key="FontSizeTitle">20</x:Double>
    <x:Double x:Key="FontSizeSubtitle">14</x:Double>
    <x:Double x:Key="FontSizeBodyLarge">15</x:Double>
    <x:Double x:Key="FontSizeBody">13</x:Double>
    <x:Double x:Key="FontSizeSmall">11</x:Double>
    <x:Double x:Key="FontSizeCaption">11</x:Double>
    <x:Double x:Key="FontSizeSectionLabel">10</x:Double>
    <x:Double x:Key="FontSizeFieldLabel">11</x:Double>
    <x:Double x:Key="FontSizeFieldValue">15</x:Double>
    <x:Double x:Key="FontSizeButton">13</x:Double>
    <x:Double x:Key="FontSizeProgress">14</x:Double>

    <!-- Font Weights -->
    <FontWeight x:Key="FontWeightBold">SemiBold</FontWeight>
    <FontWeight x:Key="FontWeightSemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="FontWeightMedium">Medium</FontWeight>
    <FontWeight x:Key="FontWeightNormal">Normal</FontWeight>

    <!-- Letter Spacing -->
    <x:Double x:Key="LetterSpacingTitle">-0.2</x:Double>
    <x:Double x:Key="LetterSpacingSectionLabel">1.2</x:Double>
    <x:Double x:Key="LetterSpacingDefault">0.0</x:Double>

</ResourceDictionary>
